<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.controllers.Lab3Controller" style="-fx-background-color: #faf0e6; -fx-padding: 20;">
    <children>
        <Label text="Лабораторная работа 3 - Переводчик"
               style="-fx-text-fill: #8B4513; -fx-font-weight: bold; -fx-font-size: 16px;" />

        <!-- Выбор файла словаря -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Файл словаря:" style="-fx-min-width: 100px;"/>
                <TextField fx:id="dictionaryPathField" promptText="Путь к файлу словаря"
                           style="-fx-min-width: 250px;"/>
                <Button fx:id="browseButton" text="Обзор"
                        style="-fx-background-color: #4682b4; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="autoFindButton" text="Найти dict"
                        style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="loadDictionaryButton" text="Загрузить"
                        style="-fx-background-color: #6b8e23; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <!-- Ввод текста для перевода -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Текст для перевода:" style="-fx-min-width: 100px;"/>
                <TextField fx:id="inputTextField" promptText="Введите английский текст"
                           style="-fx-min-width: 300px;"/>
                <Button fx:id="translateButton" text="Перевести"
                        style="-fx-background-color: #cd853f; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <!-- Проверка слова -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Проверить слово:" style="-fx-min-width: 100px;"/>
                <TextField fx:id="checkWordField" promptText="Введите слово"
                           style="-fx-min-width: 200px;"/>
                <Button fx:id="checkWordButton" text="Проверить"
                        style="-fx-background-color: #9370db; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <!-- Кнопки управления -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="infoButton" text="Информация"
                        style="-fx-background-color: #deb887; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100px;"/>
                <Button fx:id="resetButton" text="Сброс"
                        style="-fx-background-color: #dc143c; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 80px;"/>
            </children>
        </HBox>

        <!-- Область вывода -->
        <TextArea fx:id="outputTextArea" prefHeight="300.0" prefWidth="600.0"
                  style="-fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-background-color: #ffffff; -fx-border-color: #d2b48c; -fx-border-width: 2px;"/>
    </children>
</VBox>