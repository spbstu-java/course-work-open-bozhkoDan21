<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.controllers.Lab1Controller" style="-fx-background-color: #faf0e6; -fx-padding: 20;">
    <children>
        <Label text="Лабораторная работа 1 - Паттерн 'Стратегия'"
               style="-fx-text-fill: #8B4513; -fx-font-weight: bold; -fx-font-size: 16px;" />

        <!-- Кнопки выбора стратегии -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="walkButton" mnemonicParsing="false" text="🚶 Пешком"
                        style="-fx-background-color: #deb887; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
                <Button fx:id="rideButton" mnemonicParsing="false" text="🐴 На лошади"
                        style="-fx-background-color: #cd853f; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
                <Button fx:id="flyButton" mnemonicParsing="false" text="✈️ Лететь"
                        style="-fx-background-color: #a0522d; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
            </children>
        </HBox>

        <!-- Кнопки действий -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="moveButton" mnemonicParsing="false" text="▶️ Переместиться"
                        style="-fx-background-color: #6b8e23; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 140px;" />
                <Button fx:id="positionButton" mnemonicParsing="false" text="📍 Позиция"
                        style="-fx-background-color: #4682b4; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 100px;" />
                <Button fx:id="strategyButton" mnemonicParsing="false" text="📋 Стратегия"
                        style="-fx-background-color: #9370db; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 100px;" />
                <Button fx:id="resetButton" mnemonicParsing="false" text="🔄 Сброс"
                        style="-fx-background-color: #dc143c; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 80px;" />
            </children>
        </HBox>

        <!-- Область вывода -->
        <TextArea fx:id="outputTextArea" prefHeight="250.0" prefWidth="600.0"
                  style="-fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-background-color: #ffffff; -fx-border-color: #d2b48c; -fx-border-width: 2px;" />
    </children>
</VBox>