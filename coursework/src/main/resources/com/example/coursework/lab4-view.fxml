<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.controllers.Lab4Controller" style="-fx-background-color: #faf0e6; -fx-padding: 20;">
    <children>
        <Label text="Лабораторная работа 4 - Stream API операции"
               style="-fx-text-fill: #8B4513; -fx-font-weight: bold; -fx-font-size: 16px;" />

        <!-- Поля ввода -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Числа:" style="-fx-min-width: 80px;"/>
                <TextField fx:id="numbersInputField" promptText="Введите числа через пробел"
                           style="-fx-min-width: 300px;"/>
            </children>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Строки:" style="-fx-min-width: 80px;"/>
                <TextField fx:id="stringsInputField" promptText="Введите строки через запятую"
                           style="-fx-min-width: 300px;"/>
            </children>
        </HBox>

        <!-- Кнопки операций -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="averageButton" text="Среднее"
                        style="-fx-background-color: #4682b4; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="prefixButton" text="Префикс"
                        style="-fx-background-color: #cd853f; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="uniqueSquaresButton" text="Квадраты"
                        style="-fx-background-color: #6b8e23; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="lastElementButton" text="Последний"
                        style="-fx-background-color: #9370db; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="sumEvenButton" text="Четные"
                        style="-fx-background-color: #deb887; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="mapButton" text="Map"
                        style="-fx-background-color: #a0522d; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <!-- Кнопки управления -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="infoButton" text="Справка"
                        style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="clearButton" text="Очистить"
                        style="-fx-background-color: #dc143c; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </HBox>

        <!-- Область вывода -->
        <TextArea fx:id="outputTextArea" prefHeight="300.0" prefWidth="600.0"
                  style="-fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-background-color: #ffffff; -fx-border-color: #d2b48c; -fx-border-width: 2px;"/>
    </children>
</VBox>