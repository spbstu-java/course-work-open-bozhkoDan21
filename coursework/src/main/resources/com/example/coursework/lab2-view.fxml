<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.controllers.Lab2Controller" style="-fx-background-color: #faf0e6; -fx-padding: 20;">
    <children>
        <Label text="Лабораторная работа 2 - Аннотации и рефлексия"
               style="-fx-text-fill: #8B4513; -fx-font-weight: bold; -fx-font-size: 16px;" />

        <!-- Кнопки вызова методов -->
        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="publicMethodsButton" mnemonicParsing="false" text="Public методы"
                        style="-fx-background-color: #deb887; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
                <Button fx:id="privateMethodsButton" mnemonicParsing="false" text="Private методы"
                        style="-fx-background-color: #cd853f; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
                <Button fx:id="protectedMethodsButton" mnemonicParsing="false" text="Protected методы"
                        style="-fx-background-color: #a0522d; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
            </children>
        </HBox>

        <HBox spacing="10.0" alignment="CENTER">
            <children>
                <Button fx:id="allMethodsButton" mnemonicParsing="false" text="Все методы"
                        style="-fx-background-color: #6b8e23; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 120px;" />
                <Button fx:id="infoButton" mnemonicParsing="false" text="Информация"
                        style="-fx-background-color: #4682b4; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 100px;" />
                <Button fx:id="resetButton" mnemonicParsing="false" text="Сброс"
                        style="-fx-background-color: #dc143c; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 80px;" />
            </children>
        </HBox>

        <!-- Область вывода -->
        <TextArea fx:id="outputTextArea" prefHeight="300.0" prefWidth="600.0"
                  style="-fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-background-color: #ffffff; -fx-border-color: #d2b48c; -fx-border-width: 2px;" />
    </children>
</VBox>