<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.controllers.MainController" style="-fx-background-color: #f5f5dc;">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <children>
        <Label text="Курсовая работа" style="-fx-text-fill: #8B4513; -fx-font-weight: bold;">
            <font>
                <Font size="28.0" />
            </font>
        </Label>

        <Label text="Выберите лабораторную работу:" style="-fx-text-fill: #696969; -fx-font-size: 14px;" />

        <VBox spacing="15.0" alignment="CENTER">
            <Button fx:id="lab1Button" mnemonicParsing="false" text="Лабораторная работа 1"
                    style="-fx-background-color: #d2b48c; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 250px; -fx-min-height: 40px;" />
            <Button fx:id="lab2Button" mnemonicParsing="false" text="Лабораторная работа 2"
                    style="-fx-background-color: #d2b48c; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 250px; -fx-min-height: 40px;" />
            <Button fx:id="lab3Button" mnemonicParsing="false" text="Лабораторная работа 3"
                    style="-fx-background-color: #d2b48c; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 250px; -fx-min-height: 40px;" />
            <Button fx:id="lab4Button" mnemonicParsing="false" text="Лабораторная работа 4"
                    style="-fx-background-color: #d2b48c; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-min-width: 250px; -fx-min-height: 40px;" />
        </VBox>
    </children>
</VBox>